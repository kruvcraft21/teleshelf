# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(name)s | %(message)s

# Telegram bot and API application
BOT_TOKEN=replace_with_botfather_token
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_telegram_api_hash

# Public URL used in links sent by the bot
API_DOMAIN=https://reader.example.com/

# PostgreSQL
# Use db as POSTGRES_HOST when running through Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telega_reader
POSTGRES_USER=telega_reader
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Redis
# Use redis as REDIS_HOST when running through Docker Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SESSION_TTL=3600
REDIS_MAX_CONNECTIONS=10

# Bot FSM
FSM_DATA_TTL_SECONDS=3600
FSM_STATE_TTL_SECONDS=3600

# Persist reader positions from Redis to PostgreSQL
TRANSFER_JOB_INTERVAL_MINUTES=15
TRANSFER_JOB_SCHEDULER_MAX_INSTANCES=1
